{
  "name": "mail-job-manager",
  "version": "1.0.0",
  "description": "Ứng dụng quản lý job gửi mail tự động với Chrome profiles",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint server.js src",
    "lint:fix": "eslint server.js src --fix",
    "format": "prettier --write \"server.js\" \"src/**/*.js\" \"eslint.config.js\" \"package.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"server.js\" \"src/**/*.js\" \"eslint.config.js\" \"package.json\" \".prettierrc.json\""
  },
  "keywords": [
    "email",
    "automation",
    "chrome",
    "gmail"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^128.0.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.3"
  }
}
